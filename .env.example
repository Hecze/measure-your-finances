# Copia este archivo a .env y completa lo que necesites.
# Todo (menos APP_PASSWORD y SECRET_KEY) también se puede configurar desde la pantalla de Ajustes.

# Contraseña para entrar a la app. Déjala vacía SOLO si la app no es accesible desde fuera de tu PC.
APP_PASSWORD=cambia-esta-contraseña
# Cadena larga y aleatoria para firmar la sesión (ej.: python -c "import secrets;print(secrets.token_hex(32))")
SECRET_KEY=

# URL donde la abres (para los links de las notificaciones)
BASE_URL=http://localhost:8000

# Correo (IMAP). Para Gmail usa una "contraseña de aplicación", no tu contraseña normal.
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
SYNC_INTERVAL_MINUTES=15
SYNC_DAYS_BACK=90

# IA opcional: none | anthropic | openai_compatible
LLM_PROVIDER=none
# Para anthropic:
ANTHROPIC_API_KEY=
# Para openai_compatible (Ollama, LM Studio, OpenRouter...):
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=
LLM_API_KEY=

# Notificaciones push opcionales (https://ntfy.sh)
NTFY_URL=
